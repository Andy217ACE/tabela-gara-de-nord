# © 2026 Andy217Ace
# Model pentru /etc/tabela.env (root, chmod 600). Fără valori reale în repo.
DB_PATH=/var/lib/tabela/tabela.db
LAST_IMAGE_PATH=/var/lib/tabela/last.jpg
POLLER_ENABLED=1
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Capturi OCR (imaginile expiră după CAPTURE_RETENTION_DAYS zile; metadatele rămân)
CAPTURE_DIR=/var/lib/tabela/captures
CAPTURE_RETENTION_DAYS=7
CAPTURE_MIN_FREE_MB=2048
# Cheia de administrare pentru /#ocr (minim 12 caractere; se compară în timp constant)
ADMIN_TOKEN=
# Meteo (Open-Meteo, valori de model)
WEATHER_ENABLED=1
