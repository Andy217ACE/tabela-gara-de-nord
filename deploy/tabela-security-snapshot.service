# Exportatorul de securitate (scripts/security_snapshot.py): rulează ca root, DOAR CITIRE
# (DB-ul fail2ban mode=ro, /var/log/fail2ban.log*, /var/log/nginx/access.log*) și scrie atomic
# /var/lib/tabela/security/snapshot.json (0640, grup tabela) pentru cardul „Securitate" din
# #admin. Aplicația nu primește niciun privilegiu. Instalat de deploy/update.sh și install.sh.
# Python de sistem (-I: fără site-packages, fără PYTHON*), cod root-owned din /opt/tabela/app.
[Unit]
Description=Tabela Gara de Nord - snapshot securitate (fail2ban + nginx, doar citire)
After=fail2ban.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/tabela/app/scripts/security_snapshot.py --out /var/lib/tabela/security/snapshot.json
# MAX_RUN_S=40 s pentru log-uri + DB/jurnal fail2ban; limitele protejează tabela.service
TimeoutStartSec=120
MemoryMax=256M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle

# Hardening: citește orice (CAP_DAC_READ_SEARCH), schimbă grupul fișierului scris (CAP_CHOWN),
# scrie doar în /var/lib/tabela/security, fără rețea.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tabela/security
PrivateTmp=yes
ProtectHome=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027
